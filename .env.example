# Copy this file to cms/.env and replace every example secret.
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
CMS_API_TOKEN=replace-with-at-least-48-random-characters

# --- Database (PostgreSQL) --------------------------------------------------
# Local: a Postgres you run yourself, e.g.
#   docker run -d --name arcp-pg -e POSTGRES_PASSWORD=arcp -p 5432:5432 postgres:16
DATABASE_URL=postgres://postgres:arcp@localhost:5432/postgres

# --- Uploads -------------------------------------------------------------
# Uploads are stored in cms/media by default. Optional: an S3-compatible bucket
# (Cloudflare R2, Backblaze B2, AWS) instead of local disk:
#      S3_BUCKET=arcp-media
#      S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#      S3_ACCESS_KEY_ID=...
#      S3_SECRET_ACCESS_KEY=...
#  - A persistent disk (VPS): PAYLOAD_MEDIA_DIR=/var/data/media

CMS_PUBLIC_URL=http://localhost:3001
PUBLIC_SITE_URL=http://localhost:3000

# Used once by `npm run seed` to create the first owner account.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
