# Copy this file to cms/.env and replace every example secret.
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
CMS_API_TOKEN=replace-with-at-least-48-random-characters

# --- Database ---------------------------------------------------------------
# Local development: an embedded SQLite file.
DATABASE_URL=file:./data/arcp.db
# Hosted (free) SQLite via Turso / libSQL — use these two instead:
# DATABASE_URL=libsql://your-database-name.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token

# --- Uploads --------------------------------------------------------------
# Local development writes to cms/media. Optionally pin it to a disk mount:
# PAYLOAD_MEDIA_DIR=/var/data/media
# Or store files in an S3-compatible bucket (Cloudflare R2, Backblaze B2, AWS).
# When S3_BUCKET is set, uploads go to the bucket and cms/media is not used.
# S3_BUCKET=arcp-media
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key

CMS_PUBLIC_URL=http://localhost:3001
PUBLIC_SITE_URL=http://localhost:3000

# Used once by `npm run seed` to create the first owner account.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
