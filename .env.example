# Copy this file to cms/.env and replace every example secret.
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
CMS_API_TOKEN=replace-with-at-least-48-random-characters

# SQLite is embedded. The database file and the media directory must both live
# on a persistent disk and be backed up.
DATABASE_URL=file:./data/arcp.db

# Absolute path to the uploads directory. Set this to the persistent disk mount
# when hosting on Render / Fly / a VPS, e.g. /var/data/media. Leave unset locally.
# PAYLOAD_MEDIA_DIR=/var/data/media

CMS_PUBLIC_URL=http://localhost:3001
PUBLIC_SITE_URL=http://localhost:3000

# Used once by `npm run seed` to create the first owner account.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
