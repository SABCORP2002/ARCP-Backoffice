{
  "name": "arcp-administration",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Separate ARCP administration website powered by Payload CMS and SQLite.",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3001",
    "build": "npm run generate:importmap && npm run generate:types && cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:fresh": "yes | cross-env NODE_OPTIONS=--no-deprecation payload migrate:fresh --force-accept-warning",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed.ts",
    "deploy": "npm run migrate && npm run seed && npm run build",
    "deploy:fresh": "npm run migrate:fresh && npm run seed && npm run build",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "cross-env": "10.1.0",
    "next": "16.3.3",
    "payload": "3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "dompurify": "3.4.14",
    "esbuild": "0.28.2"
  }
}
