# Copy this file to cms/.env and replace every example secret.
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
CMS_API_TOKEN=replace-with-at-least-48-random-characters

# --- Database (PostgreSQL) --------------------------------------------------
# Local: a Postgres you run yourself, e.g.
#   docker run -d --name arcp-pg -e POSTGRES_PASSWORD=arcp -p 5432:5432 postgres:16
DATABASE_URL=postgres://postgres:arcp@localhost:5432/postgres
# On Vercel: attach the "Postgres" storage to the project and it injects
# POSTGRES_URL / POSTGRES_URL_NON_POOLING automatically — leave DATABASE_URL unset.

# --- Uploads -------------------------------------------------------------
# Local development writes to cms/media. In production, pick one store:
#  - Vercel Blob: attach the "Blob" storage to the project (injects
#    BLOB_READ_WRITE_TOKEN), nothing else to set.
#  - S3-compatible (Cloudflare R2, Backblaze B2, AWS):
#      S3_BUCKET=arcp-media
#      S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#      S3_ACCESS_KEY_ID=...
#      S3_SECRET_ACCESS_KEY=...
#  - A persistent disk (VPS): PAYLOAD_MEDIA_DIR=/var/data/media

CMS_PUBLIC_URL=http://localhost:3001
PUBLIC_SITE_URL=http://localhost:3000

# Used once by `npm run seed` to create the first owner account.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
